rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // User's private catalogs
      match /catalogs/{catalogId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(catalogId);
        allow delete: if isOwner(userId);
      }
    }

    // Public catalogs
    match /public_catalogs/{catalogId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(catalogId) && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
